@startuml UML类图
title 结构性图：类图（领域模型）
skinparam nodesep 16
skinparam ranksep 18

skinparam shadowing false
skinparam dpi 140
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 12
skinparam backgroundColor #FFFEFB
skinparam roundcorner 4
skinparam classAttributeIconSize 0
skinparam ArrowColor #243044
skinparam ClassBorderColor #243044
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E7F0EE
skinparam EnumBorderColor #243044
skinparam EnumBackgroundColor #FFF6E8
skinparam PackageBorderColor #243044
skinparam PackageBackgroundColor #F7F4EE
skinparam NoteBackgroundColor #FFF6E8
skinparam NoteBorderColor #C4622D
hide circle

package "用户与权限" {
  enum 账号角色 {
    参与者
    组织者
    检票人员
    平台管理员
  }
  class 用户 {
    用户编号
    用户名
    手机号
    密码摘要
    角色
    是否启用
    --
    能否执行(操作, 对象): 布尔
  }
  class 活动检票授权 {
    授权编号
    活动编号
    用户编号
    指定人
    指定时间
    --
    是否覆盖该活动(): 布尔
  }
}

package "活动、场次与票种" {
  enum 活动状态 {
    草稿
    待审核
    已驳回
    已发布
    已下架
    已取消
    已结束
  }
  class 活动 {
    活动编号
    组织者编号
    标题
    分类
    城市
    介绍
    封面
    状态
    报名是否需审核
    驳回原因
    --
    提交审核()
    发布()
    下架()
    取消()
  }
  class 场次 {
    场次编号
    活动编号
    名称
    开始时间
    结束时间
    报名截止时间
    地点
    容量
    已报名数
    候补数
    --
    仍有余量(): 布尔
    占用名额()
    释放名额并递补(): 报名记录
  }
  class 票种 {
    票种编号
    场次编号
    名称
    价格
    是否免费
    --
    校验价格(): 布尔
  }
  enum 变更状态 {
    待审核
    已通过
    已驳回
  }
  class 变更申请 {
    申请编号
    活动编号
    申请人编号
    状态
    申请说明
    审核人
    审核意见
    --
    通过后生效()
  }
  class 变更项 {
    变更项编号
    申请编号
    对象类型
    对象编号
    字段
    原值
    新值
  }
}

package "报名与支付状态" {
  enum 报名状态 {
    待审核
    已通过
    候补中
    已取消
    已签到
    已失效
    已缺席
  }
  enum 支付状态 {
    待支付
    已支付
    待退款
  }
  class 报名记录 {
    报名编号
    报名号
    用户编号
    场次编号
    票种编号
    状态
    拒绝或取消原因
    支付状态
    进入候补时间
    创建时间
    --
    是否有效报名(): 布尔
    转换到(新状态)
    标记支付(新状态)
  }
}

package "签到、通知与审计" {
  class 签到记录 {
    记录编号
    报名编号
    检票人编号
    签到时间
  }
  enum 通知类型 {
    审核结果
    递补成功
    活动取消
    关键信息变更
  }
  class 通知记录 {
    通知编号
    接收人编号
    类型
    活动编号
    场次编号
    内容
    创建时间
    已读时间
    --
    标记已读()
  }
  class 操作日志 {
    日志编号
    操作人编号
    操作类型
    对象类型
    对象编号
    结果
    详情
    发生时间
    --
    {static} 追加(条目): 操作日志
  }
}

用户 "1" --> "0..*" 活动 : 组织 >
活动 "1" *-- "1..*" 场次
场次 "1" *-- "1..*" 票种
活动 "1" *-- "0..*" 活动检票授权
用户 "1" --> "0..*" 活动检票授权 : 被授权检票 >

用户 "1" --> "0..*" 报名记录
场次 "1" --> "0..*" 报名记录
票种 "1" --> "0..*" 报名记录
报名记录 "1" --> "0..1" 签到记录
用户 "1" --> "0..*" 签到记录 : 核销 >

用户 "1" --> "0..*" 通知记录 : 接收 >
活动 "1" --> "0..*" 变更申请
变更申请 "1" *-- "1..*" 变更项
用户 "1" --> "0..*" 操作日志 : 发起 >

活动 --> 活动状态
用户 --> 账号角色
报名记录 --> 报名状态
报名记录 --> 支付状态
变更申请 --> 变更状态
通知记录 --> 通知类型

legend bottom
|= 对象 |= 设计约束 |
| 场次 | 容量、已报名数、候补数都记在场次上。已报名数只计“已通过”和“已签到”，待审核和候补不占名额。三个数在同一事务里改。 |
| 报名记录 | 同一用户在同一场次只能有一条有效报名：待审核、已通过、候补中。已取消或已失效后可以再报。免费票没有支付状态。 |
| 活动检票授权 | 账号角色里有检票人员。真正能核销的范围仍看这张授权，没有授权就不能操作该活动。组织者也可以把检票权授给某个参与者账号。 |
| 变更项 | 只能改场次时间、票种价格、场次容量。审核结束前，对外仍使用原值。 |
| 操作日志 | 只有追加，没有修改和删除。通知记录是另一张表。 |
endlegend
@enduml
